{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "coderello/laravel-nova-lang": "^2.0.1",
        "emilianotisato/nova-tinymce": "^2.0.0",
        "guzzlehttp/guzzle": "^7.7",
        "gwd/seo-meta-nova-field": "^1.2",
        "halimtuhu/array-files": "^1.0",
        "kongulov/nova-tab-translatable": "^2.1.1",
        "laravel-lang/lang": "~12.22.1",
        "laravel-notification-channels/telegram": "^4.0.0",
        "laravel/framework": "^10",
        "laravel/horizon": "^5.17",
        "laravel/nova": "^4.21",
        "laravel/octane": "^2.0.1",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8",
        "mews/purifier": "^3.3",
        "oneduo/nova-file-manager": "^0.9.2",
        "optimistdigital/nova-settings": "^5.1.0",
        "silvanite/novatoolpermissions": "^1.1",
        "ryphoe/php-ref": "^1.3",
        "spatie/laravel-feed": "^4.0",
        "spatie/laravel-sitemap": "^6.0",
        "stepanenko3/nova-logs-tool": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.23",
        "mockery/mockery": "^1.6.2",
        "nunomaduro/collision": "^7.6",
        "spatie/laravel-ignition": "^2.1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "./nova"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
