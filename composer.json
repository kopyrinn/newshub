{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "ankitech/laravel-editorjs-html": "^1.0",
        "appstract/nova-horizon": "^2.1",
        "cloudstudio/resource-generator": "^1.5",
        "coderello/laravel-nova-lang": "^1.7",
        "david-griffiths/nova-dark-theme": "^1.0",
        "digital-creative/conditional-container": "^1.4",
        "emilianotisato/nova-tinymce": "^1.2",
        "fruitcake/laravel-cors": "^2.0",
        "fx3costa/laravelchartjs": "^2.8",
        "google/recaptcha": "^1.2",
        "gregoriohc/laravel-nova-theme-responsive": "^0.8.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "gwd/seo-meta-nova-field": "^1.2",
        "halimtuhu/array-files": "^1.0",
        "infinety-es/nova-filemanager": "^2.8",
        "jenssegers/date": "^4.0",
        "joedixon/nova-translation": "^1.0",
        "kongulov/nova-tab-translatable": "^1.0",
        "laravel-lang/lang": "~8.0",
        "laravel-notification-channels/telegram": "^0.6.0",
        "laravel/framework": "^8.54",
        "laravel/horizon": "^5.9",
        "laravel/nova": "*",
        "laravel/sanctum": "^2.11",
        "laravel/telescope": "^4.6",
        "laravel/tinker": "^2.5",
        "mad-web/nova-telescope-link": "^4.0",
        "mcamara/laravel-localization": "^1.6",
        "mews/purifier": "^3.3",
        "mostafaznv/larupload": "^0.0.12",
        "naxon/nova-field-sortable": "^1.0",
        "optimistdigital/nova-multiselect-field": "^2.3",
        "optimistdigital/nova-settings": "^3.2",
        "rolandstarke/laravel-thumbnail": "^1.0",
        "ryphoe/php-ref": "^1.3",
        "silvanite/novafieldcheckboxes": "^1.2",
        "silvanite/novatoolpermissions": "^1.1",
        "spatie/laravel-feed": "^4.0",
        "spatie/laravel-sitemap": "^6.0",
        "spatie/schema-org": "^3.8",
        "tightenco/nova-google-analytics": "^0.3.1",
        "tymon/jwt-auth": "^1.0.2",
        "unisharp/laravel-filemanager": "^2.2",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "./nova"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
