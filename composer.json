{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "cloudstudio/resource-generator": "^1.5",
        "coderello/laravel-nova-lang": "^2.0.1",
        "david-griffiths/nova-dark-theme": "^1.0",
        "digital-creative/conditional-container": "^1.4",
        "emilianotisato/nova-tinymce": "^1.2",
        "google/recaptcha": "^1.2",
        "gregoriohc/laravel-nova-theme-responsive": "^0.8.1",
        "guzzlehttp/guzzle": "^7.2",
        "gwd/seo-meta-nova-field": "^1.2",
        "halimtuhu/array-files": "^1.0",
        "infinety-es/nova-filemanager": "^2.8",
        "jenssegers/date": "^4.0",
        "kongulov/nova-tab-translatable": "^1.0",
        "laravel-lang/lang": "~12.20.5",
        "laravel-notification-channels/telegram": "^2.1.0",
        "laravel/framework": "^9",
        "laravel/horizon": "^5.9",
        "laravel/nova": "*",
        "laravel/octane": "^1.5",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8",
        "mad-web/nova-telescope-link": "^4.0",
        "mews/purifier": "^3.3",
        "optimistdigital/nova-settings": "^3.5",
        "ryphoe/php-ref": "^1.3",
        "silvanite/novafieldcheckboxes": "^1.2",
        "silvanite/novatoolpermissions": "^1.1",
        "spatie/laravel-feed": "^4.0",
        "spatie/laravel-sitemap": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "laravel/telescope": "^4.14.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "./nova"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
